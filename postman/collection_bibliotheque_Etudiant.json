{
  "info": { "name": "API Bibliothèque — Étudiant", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json", "description": "Collection professionnelle de l'API REST de gestion de bibliothèque." },
  "variable": [{ "key": "base_url", "value": "http://localhost:8000/api/v1" }, { "key": "token", "value": "" }],
  "item": [
    { "name": "Authentification", "item": [
      { "name": "POST Login", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"bibliothecaire@example.com\",\n  \"password\": \"password123\"\n}" } }, "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const jsonData = pm.response.json();", "if (jsonData.success && jsonData.data.token) pm.environment.set('token', jsonData.data.token);", "pm.test('Login réussi', () => pm.response.to.have.status(200));", "pm.test('Token non vide', () => pm.expect(jsonData.data.token).to.be.a('string').and.not.empty);", "pm.test('Réponse uniforme', () => pm.expect(jsonData.success).to.be.true);"] } }] },
      { "name": "POST Login KO", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }, "body": { "mode": "raw", "raw": "{\n  \"email\": \"inconnu@example.com\",\n  \"password\": \"incorrect\"\n}" } }, "event": [{ "listen": "test", "script": { "exec": ["const res = pm.response.json();", "pm.test('Status 401', () => pm.response.to.have.status(401));", "pm.test('Échec identifié', () => pm.expect(res.success).to.be.false);"] } }] }
    ]},
    { "name": "Authors", "item": [
      { "name": "GET Authors", "request": { "method": "GET", "url": "{{base_url}}/authors" }, "event": [{ "listen": "test", "script": { "exec": ["const res=pm.response.json();", "pm.test('Status 200',()=>pm.response.to.have.status(200));", "pm.test('Tableau',()=>pm.expect(res.data).to.be.an('array'));"] } }] },
      { "name": "POST Author", "request": { "method": "POST", "header": [{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}], "url": "{{base_url}}/authors", "body": { "mode":"raw", "raw":"{\n  \"first_name\": \"George\",\n  \"last_name\": \"Orwell\",\n  \"nationality\": \"Britannique\"\n}" } }, "event": [{ "listen":"test", "script":{"exec":["const res=pm.response.json();","pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('Auteur créé',()=>pm.expect(res.data.id).to.be.a('number'));","if(res.data&&res.data.id)pm.environment.set('author_id',res.data.id);"]}}] },
      { "name": "GET Author", "request":{"method":"GET","url":"{{base_url}}/authors/{{author_id}}"}, "event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Livres présents',()=>pm.expect(res.data).to.have.property('books'));"]}}] },
      { "name": "PUT Author", "request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/authors/{{author_id}}","body":{"mode":"raw","raw":"{\n  \"first_name\": \"George\",\n  \"last_name\": \"Orwell\",\n  \"nationality\": \"Anglaise\"\n}"}}, "event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Modification réussie',()=>pm.expect(res.success).to.be.true);"]}}] },
      { "name":"DELETE Author","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/authors/{{author_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 204',()=>pm.response.to.have.status(204));","pm.test('Corps vide',()=>pm.expect(pm.response.text()).to.eql(''));"]}}] }
    ]},
    { "name":"Books","item":[
      {"name":"GET Books","request":{"method":"GET","url":"{{base_url}}/books"},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('success true',()=>pm.expect(res.success).to.be.true);","pm.test('Tableau',()=>pm.expect(res.data).to.be.an('array'));"]}}]},
      {"name":"GET Books Available","request":{"method":"GET","url":"{{base_url}}/books?available=true"},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Livres disponibles',()=>res.data.forEach(b=>pm.expect(b.available).to.be.true));"]}}]},
      {"name":"POST Book","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/books","body":{"mode":"raw","raw":"{\n  \"title\": \"1984\",\n  \"isbn\": \"978-0451524935\",\n  \"year\": 1949,\n  \"available\": true,\n  \"author_id\": {{author_id}}\n}"}},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","const sent=JSON.parse(pm.request.body.raw);","pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('Titre correspond',()=>pm.expect(res.data.title).to.eql(sent.title));","if(res.data&&res.data.id)pm.environment.set('book_id',res.data.id);"]}}]},
      {"name":"POST Book Sans Auth","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/books","body":{"mode":"raw","raw":"{\n  \"title\": \"Sans auth\",\n  \"isbn\": \"111-1111111111\",\n  \"year\": 2020,\n  \"author_id\": 1\n}"}},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 401',()=>pm.response.to.have.status(401));","pm.test('Échec',()=>pm.expect(res.success).to.be.false);"]}}]},
      {"name":"GET Book","request":{"method":"GET","url":"{{base_url}}/books/{{book_id}}"},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('ID demandé',()=>pm.expect(res.data.id).to.eql(Number(pm.variables.get('book_id'))));","pm.test('Auteur présent',()=>pm.expect(res.data.author).to.exist);"]}}]},
      {"name":"GET Book 404","request":{"method":"GET","url":"{{base_url}}/books/999999"},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 404',()=>pm.response.to.have.status(404));","pm.test('Échec',()=>pm.expect(res.success).to.be.false);"]}}]},
      {"name":"PUT Book","request":{"method":"PUT","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/books/{{book_id}}","body":{"mode":"raw","raw":"{\n  \"title\": \"1984 - édition revue\",\n  \"year\": 1949\n}"}},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Modification réussie',()=>pm.expect(res.success).to.be.true);"]}}]},
      {"name":"DELETE Book","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/books/{{book_id}}"},"event":[{"listen":"test","script":{"exec":["pm.test('Status 204',()=>pm.response.to.have.status(204));","pm.test('Réponse sans corps',()=>pm.expect(pm.response.text()).to.eql(''));"]}}]}
    ]},
    {"name":"Borrows","item":[
      {"name":"GET Borrows","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/borrows"},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Tableau',()=>pm.expect(res.data).to.be.an('array'));"]}}]},
      {"name":"POST Borrow","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"url":"{{base_url}}/borrows","body":{"mode":"raw","raw":"{\n  \"user_name\": \"Postman Test\",\n  \"book_id\": 1\n}"}},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 201',()=>pm.response.to.have.status(201));","pm.test('book_id correct',()=>pm.expect(res.data.book_id).to.eql(1));","pm.test('returned_at null',()=>pm.expect(res.data.returned_at).to.eql(null));","if(res.data&&res.data.id)pm.environment.set('borrow_id',res.data.id);"]}}]},
      {"name":"PATCH Return Borrow","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/borrows/{{borrow_id}}/return"},"event":[{"listen":"test","script":{"exec":["const res=pm.response.json();","pm.test('Status 200',()=>pm.response.to.have.status(200));","pm.test('Livre rendu',()=>pm.expect(res.data.returned_at).to.not.eql(null));"]}}]}
    ]}
  ]
}
